# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/employee_service_db?schema=public"

# Authentication Secrets (To be populated in Phase 2)
JWT_SECRET="replace-with-a-random-secure-64-character-secret-key"
JWT_EXPIRES_IN="1d"
